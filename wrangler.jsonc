/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wargame",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-26",
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
	/**
	 * The Vue client, built by Vite (the Cloudflare Vite plugin supplies the directory).
	 * Only /api/* hits the Worker; everything else is served straight from Workers Assets.
	 */
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"],
	},
	/**
	 * All game data: accounts, invites, GM config AND player state. Each plugin owns tables
	 * prefixed with its id; schema lives in ./migrations. Before the first deploy run
	 * `wrangler d1 create wargame-db` and add the printed `database_id` here (local dev
	 * and tests work without it).
	 */
	"d1_databases": [{ "binding": "DB", "database_name": "wargame-db", "migrations_dir": "migrations" }],
	/**
	 * Files: baked static views, the terrain file, puzzle pictures (keys prefixed "static/", "terrain/", "puzzles/").
	 * Before the first deploy run `wrangler r2 bucket create wargame-files`; locally and in Docker it is emulated
	 * under .data/local. FILES_BASE_URL: the bucket's public URL (a custom domain), so browsers fetch those files
	 * straight from R2 without a Worker request; empty: through the Worker (/api/static/...).
	 */
	"r2_buckets": [{ "binding": "FILES", "bucket_name": "wargame-files" }],
	"vars": { "FILES_BASE_URL": "" },
	/**
	 * The GM (super user). Set with `wrangler secret put GM_USERNAME` / `GM_PASSWORD`
	 * in production, or in .dev.vars locally.
	 */
	"secrets": { "required": ["GM_USERNAME", "GM_PASSWORD"] },
	/** Background tasks registered by plugins (`ctx.tasks.add`), e.g. the timeline sweep. */
	"triggers": { "crons": ["* * * * *"] },
	/**
	 * The deployment on Cloudflare (`CLOUDFLARE_ENV=production`, set by `pnpm run deploy` and `pnpm db:migrate`). The
	 * top level stays without a database id: local dev, tests and Docker keep their own database (with an id, the local
	 * database file would change). Bindings and vars are not inherited, so they are given again here. Others deploying
	 * this project: put your own database id, bucket, domain and files URL here (docs/deployment.md §5).
	 */
	// cloudflare-setup:begin
	// Deploying to Cloudflare: `pnpm setup:cloudflare` writes your own copy of this file, wrangler.production.jsonc (not
	// committed: database id, domain, account), with the `production` environment here; `pnpm run deploy` and
	// `pnpm db:migrate` use it (docs/deployment.md §5).
	// cloudflare-setup:end
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
